# Izinkan akses direktori agar tidak 403
Options +FollowSymLinks -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Set file indeks utama langsung ke dist/index.html
  DirectoryIndex dist/index.html

  # Jika yang diakses BUKAN folder dist, arahkan secara internal ke dalam dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>