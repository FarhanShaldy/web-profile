RewriteEngine On

RewriteBase /

# Jangan rewrite file/folder yang sudah ada di public_html
RewriteCond %{REQUEST_URI} !^/dist/

# File dan folder diambil dari dist
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
RewriteRule ^(.*)$ dist/$1 [L]

# Semua route React diarahkan ke index.html
RewriteRule ^(.*)$ dist/index.html [L]