<IfModule mod_rewrite.c>
RewriteEngine On

# Jangan proses file/folder yang memang ada di public_html
RewriteCond %{REQUEST_URI} !^/dist/

# Arahkan asset dan file ke dist
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -d
RewriteRule ^(.*)$ dist/$1 [L]

# Root dan semua route diarahkan ke React/Vite index
RewriteRule ^$ dist/index.html [L]
RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>