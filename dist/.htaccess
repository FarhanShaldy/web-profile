<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
  
    # Jangan blokir direktori atau file yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
  
    # Arahkan semua request SPA (Vite/React/Vue) ke index.html
    RewriteRule . /index.html [L] 
</IfModule>